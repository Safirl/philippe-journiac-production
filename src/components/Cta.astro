<div id="cta">
    <span>Cliquer pour ouvrir</span>
</div>

<style lang="scss">
    div {
        top: 0px;
        left: 0px;
        position: fixed;
        background-color: $color-primary;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease-in-out;
        width: max-content;
    }

    span {
        padding: 0.5rem;
        color: $color-white;
        font-size: $fontsize-primary;
    }
</style>

<script>
    document.body.style.overflow = "hidden";
    const init = () => {
        const lerpStrength = 0.8;
        let lastMousePosition = { x: 0, y: 0 };
        const btn = document.getElementById("cta");
        if (!btn) throw new Error("erreur");

        const lerp = (start: number, end: number, t: number) => {
            return start + (end - start) * t;
        };
        let elapsed: number = 0;
        const followMouse = (chrono: number) => {
            let delta = chrono - elapsed;
            elapsed = chrono;
            let top = 0;
            let left = 0;
            if (btn.style.top) {
                top = Number(btn.style.top.replace("px", ""));
            }
            if (btn.style.left) {
                left = Number(btn.style.left.replace("px", ""));
            }

            btn.style.left =
                String(
                    lerp(
                        left,
                        lastMousePosition.x + 20,
                        lerpStrength * delta * 0.01,
                    ),
                ) + "px";
            btn.style.top =
                String(
                    lerp(
                        top,
                        lastMousePosition.y - 20,
                        lerpStrength * delta * 0.01,
                    ),
                ) + "px";
            const targets = document.elementsFromPoint(
                lastMousePosition.x,
                lastMousePosition.y,
            );
            let found = false;
            targets.forEach((t) => {
                if (t.id === "ctaTrigger") found = true;
            });
            btn.style.opacity = found ? "1" : "0";
            requestAnimationFrame(followMouse);
        };

        document.addEventListener("mousemove", (e) => {
            lastMousePosition.x = e.clientX;
            lastMousePosition.y = e.clientY;
        });

        followMouse(0);
    };
    document.addEventListener("astro:page-load", init);
</script>

---
import Layout from "../layouts/Layout.astro";
---

<Layout pageTitle="Contact">
    <h1>Contact</h1>

    <p>
        Vous souhaitez faire une proposition d’achat ou demander des
        renseignements ? Contactez Philippe par mail ou via les réseaux sociaux.
    </p>

    <ul>
        <li>
            <a
                href="https://www.instagram.com/journiacphilippe/"
                target="_blank"
            >
                <img
                    src="icons/instagram-brands-solid-full.svg"
                    alt="Icone de Instagram"
                />
                @journiacphilippe
            </a>
        </li>

        <li>
            <a
                href="https://www.facebook.com/people/Philippe-Journiac/pfbid06nBv3gZeFXFo6TVzpcWX5vCVZ7StZmfPgtqSDYmfs6EuTjeaGpTnivgHrQWMXKRJl/"
                target="_blank"
            >
                <img
                    src="icons/facebook-brands-solid-full.svg"
                    alt="Icone de Facebook"
                />
                @journiacphilippe
            </a>
        </li>

        <li>
            <a href="mailto:mcjourniac@orange.fr">
                <img
                    src="icons/envelope-regular-full.svg"
                    alt="Icone d'Email"
                />
                contacter par mail
            </a>
        </li>
    </ul>
</Layout>

<style lang="scss">
    h1 {
        @include font-title();
    }

    p {
        margin-top: 4rem;
    }

    ul {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        li a {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            width: fit-content;

            &:hover {
                text-decoration: underline;
            }

            img {
                width: 2rem;
            }
        }
    }
</style>

---
import LastNews from "../components/LastNews.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import bioImage from "../images/photo-biographie.png";
---

<Layout
    pageDescription="Philippe Journiac est un artiste peintre. Découvrez son univers et ses futres expositions."
>
    <section id="hero" slot="hero">
        <h1>
            Philippe<br />
            <span>Journiac</span>
            Artiste peintre
        </h1>
    </section>

    <section id="biography">
        <div>
            <h2>Biographie</h2>

            <p>
                Philippe Journiac, né en 1958, est un peintre autodidacte. Sa
                formation artistique se résume à quatre années d'enseignement
                suivies de 11 à 14 ans à Redon. Dès l'âge de 12 ans, il est
                récompensé lors d'un concours inter-collèges. Après une reprise
                remarquée en 1995, primée au concours « Solidor en peinture » à
                Saint-Malo, il revient pleinement à la peinture en 2023. Inspiré
                par l'impressionnisme, il réalise des marines, des paysages et
                des natures mortes, cherchant à transmettre l’émotion et la
                beauté du réel à travers la lumière et les couleurs.
            </p>

            <a href="/galerie">Découvrir les tableaux</a>
        </div>

        <Image
            class={"bio-image"}
            src={bioImage}
            alt="Photo de Philippe Journiac en train de peindre."
        />

        <!-- <img
            src="./images/photo-biographie.png"
            alt="Photo de Philippe Journiac en train de peindre."
        /> -->
    </section>

    <LastNews />
</Layout>

<script>
    document.addEventListener("astro:page-load", () => {
        const header = document.querySelector("header");
        const sectionHero = document.getElementById("hero");

        if (header && sectionHero) {
            header.style.transition = "unset";
            header.style.marginBottom = `-${header.offsetHeight}px`;
            header.style.background = "unset";

            window.addEventListener("scroll", () => {
                header.style.transition = "0.5s ease";

                if (window.scrollY > 200) {
                    header.style.background = "#FFFCFB";
                } else {
                    header.style.background = "unset";
                }
            });
        }
    });
</script>

<style lang="scss">
    section#hero {
        height: 90dvh;
        background-image: url("/images/tableau-hero.png");
        background-size: cover;
        background-position: bottom;
        display: flex;
        justify-content: center;
        align-items: center;

        h1 {
            text-align: center;
            @include font-title();
            font-size: clamp(16px, 15vw, 128px);

            span {
                display: block;
                width: fit-content;
                margin: auto auto;
                transform: translateX(50%);
            }
        }
    }

    section#biography {
        margin-top: 5rem;
        display: flex;
        gap: 6rem;

        @include respond-to("tablet") {
            flex-direction: column;
            gap: 2rem;
        }

        div {
            h2 {
                @include font-title();
            }

            p {
                margin-top: 1rem;
            }

            a {
                display: block;
                width: fit-content;
                margin-top: 2rem;
                padding: 0.5rem;
                background: $color-primary;
                color: $color-white;
                font-family: $fontface-medium;
                /* font-size: 20px; */
                transition: 0.5s cubic-bezier(0, 1, 1, 1);

                &:hover {
                    scale: 0.95;
                }
            }
        }

        img {
            width: 40vw;
            max-width: 500px;
            height: 100%;
            border-radius: 1rem;
            object-fit: cover;

            @include respond-to("tablet") {
                width: unset;
                height: 300px;
            }
        }
    }
</style>

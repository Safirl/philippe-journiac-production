---
import SmoothScroll from "../components/SmoothScroll.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Footer from "../components/Footer.astro";
import Cta from "../components/Cta.astro";
import { ClientRouter, fade } from "astro:transitions";

import "../assets/styles/_reset.scss";
import "../assets/styles/style.scss";
import "../assets/styles/lenis.scss";

const { pageTitle, pageDescription } = Astro.props;
const title = pageTitle
    ? pageTitle + " | Philippe Journiac"
    : "Philippe Journiac";
---

<!doctype html>
<html lang="fr" transition:animate={fade({ duration: "1s" })}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		 todo: icons à mettre dans le dossier public
		<link rel="icon" href="/favicon.ico" /> -->
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={pageDescription} />
        <!-- todo: c'est quoi ça ? "Astro.generator" -->
        <title>{title}</title>
        <!-- todo: titre dynamique avec l'endroit de la page (exemple: "Accueil | Philippe Journiac") (ajout d'un params je crois) -->
        <ClientRouter />
    </head>

    <body>
        <Cta />
        <SmoothScroll />

        <Header />

        <slot name="hero" />

        <main>
            <Breadcrumbs />

            <slot />
        </main>

        <Footer />
    </body>
</html>
